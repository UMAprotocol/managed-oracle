[submodule "reporters/lib/openzeppelin-contracts-upgradeable"]
	path = reporters/lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
[submodule "lib/permit2"]
	path = lib/permit2
